# Normalize line endings in the repo to LF; Git converts to the platform's
# native ending on checkout. Keeps diffs clean between Windows dev and the
# Linux CI runner.
* text=auto eol=lf

# Windows-only scripts need CRLF to run correctly via powershell.exe.
*.ps1 text eol=crlf

# Binary assets — never diffed, never line-ending converted.
*.wav binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
